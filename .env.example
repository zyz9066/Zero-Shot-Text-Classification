# Non-secret example only. Prefer process environment for credential values.
# Native application API: localhost:9000. Compose application API: minio:9000.
# The browser console localhost:9001 is not the S3 API.
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
# The mandated default is preserved; services may reject its underscores.
MINIO_BUCKET=zeroshot_learning_output
# Explicit valid override for an authorized local test:
# MINIO_BUCKET=zeroshot-learning-test

# Single-quote Windows paths in .env files so uv preserves backslashes.
# Supply these external host file paths in the Docker launch terminal.
# MINIO_LICENSE_FILE='C:\external-secrets\minio.license'
# MINIO_ROOT_USER_FILE='C:\external-secrets\root-user'
# MINIO_ROOT_PASSWORD_FILE='C:\external-secrets\root-password'
# File contents are values only, without trailing whitespace/newlines.
# App MINIO_ACCESS_KEY and MINIO_SECRET_KEY are separate process inputs.
# Never put credentials, HF_TOKEN or license contents in this example.
# APP_CONFIG_FILE must name a container-visible file for Compose.
# Keep the Compose project identity stable so its volumes remain discoverable.
